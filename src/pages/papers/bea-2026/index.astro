        <span class="artifact-name">Taxonomy cross-reference (98 fine tags × corpus tagsets)</span>
        <span class="artifact-link"><a href="/papers/bea-2026/tables/cross-reference/">browse</a></span>
      </li>
      <li>
        <span class="artifact-name">Evidence table (213 §§ × 4 corpora)</span>
        <span class="artifact-link"><a href="/papers/bea-2026/tables/evidence-table/">browse</a></span>
      </li>
      <li>
        <span class="artifact-name">Per-rule LoRuGEC scores (48 × 35 conditions)</span>
        <span class="artifact-link"><a href="/papers/bea-2026/tables/per-rule/">browse</a></span>
      </li>
      <li>
        <span class="artifact-name">GERA reclassification (5,988 errors → Rozental L2)</span>
        <span class="artifact-link"><a href="/papers/bea-2026/tables/gera-reclass/">browse</a></span>
      </li>
      <li>
        <span class="artifact-name">Reasoning chains: Qwen3.5-9B think (612 chains)</span>
